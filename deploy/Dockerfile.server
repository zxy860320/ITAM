# ITYW P0 监控服务（:8787）——Express + Zabbix/dbmp 采集 + 告警出口
# 构建上下文 = 仓库根：docker build -f deploy/Dockerfile.server .
FROM node:22-alpine

WORKDIR /app

# 仅安装 server 依赖（package.json 在 server/ 下）
COPY server/package.json server/package-lock.json* ./server/
RUN cd server && npm ci --omit=dev

COPY server/src ./server/src

# 配置与状态文件（source.json / notify.json / notify_state.json / dbmp_samples.json）
# 由 compose 卷挂载 ./server/data → /app/server/data，镜像内不打包任何凭据
ENV PORT=8787
EXPOSE 8787

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8787/api/source').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "server/src/server.js"]
