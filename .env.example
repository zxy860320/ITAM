# 复制为 .env 后修改。docker compose 自动读取同目录 .env（变量替换 + mysql 服务环境）。
# ⚠️ 上生产前务必改掉两个密码；.env 含凭据，不要提交 git。

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=ityw_topology
MYSQL_USER=topology
MYSQL_PASSWORD=change-me-topology

# web(nginx) 对外端口
WEB_PORT=80

# ---- AI 助手（Open WebUI 内嵌）----
# nginx 反代 open-webui 的对外端口（平台「AI 助手」页 iframe 用）
AI_PORT=3001
# Open WebUI 若部署在别处（非本 compose 内置），填它的完整地址，iframe 直接嵌它。
# 例：AI_ASSISTANT_URL=http://10.25.6.5:3000
# 注意：OWUI 侧 MCP 地址要能反向访问到平台后端 :8787（需放开 server 端口映射/防火墙）
# AI_ASSISTANT_URL=
# 必填：固定随机串（openssl rand -hex 32），丢失会导致 OWUI 会话/OAuth 加密失效
AI_SECRET_KEY=change-me-random-secret
# 首次装好后到 OWUI 管理界面配：Integrations 加 MCP(http://server:8787/mcp, Auth=None)、Connections 配模型
# 关闭自助注册（管理员在 OWUI 后台建账号）；开放注册时设为 true
AI_ENABLE_SIGNUP=false
# ITYW MCP 的 Bearer token（留空=内网免鉴权；启用后 OWUI 侧 Auth 选 Bearer 填同值）
# ITYW_MCP_TOKEN=

# ---- AI agent（LangGraph 自研助手，平台「AI 助手 → 平台助手」标签）----
# 模型端点：任意 OpenAI 兼容接口。内网 LiteLLM 网关（实测兼容流式+tool_calls）：
#   LLM_BASE_URL=http://<litellm-host>:4000/v1，LLM_MODEL=/v1/models 里注册的名（如 general）
# 内网 Ollama：LLM_BASE_URL=http://<host>:11434/v1，LLM_MODEL=qwen2.5:32b
# 内网 vLLM：LLM_BASE_URL=http://<host>:8000/v1，LLM_MODEL=启动时 --served-model-name 的名字
LLM_BASE_URL=
# ⚠️ API key 必须是纯 ASCII（openai SDK 以 ASCII 编码 Authorization 头，混入
# 省略号等非 ASCII 字符会直接 UnicodeEncodeError）；从别处粘贴时注意别带入 U+2026。
LLM_API_KEY=
LLM_MODEL=
# 若在带 HTTP_PROXY/HTTPS_PROXY 的终端里直接跑 agent（非容器），务必剥离代理或
# NO_PROXY 包含 LLM/MCP 内网段，否则内网请求会被本地代理劫持（表现为 404/连接重置）。
# 例：env -u HTTP_PROXY -u HTTPS_PROXY -u http_proxy -u https_proxy NO_PROXY='*' ...
